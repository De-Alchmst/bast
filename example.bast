; globální proměnné, deklarované stejně jako lokální
; nutné zadat výchozí hodnotu, v tomto případě číslo výsledek výroku '2 + 3'
; čísla jsou uložena jen jako Double
; názvy proměnných používají kebab-case a jsou case-insensitive
; proměnná musí mít alespoň 2 písmena a nesmí začínat nebo končit '-'
var [
  fact-arg : 2 + 3
]


; funkce bez argumentů
; nastavena jako entrypoint řádkou 'entry : start' v 'bast.conf'
func [start]:[
  ; funkce mohou mít deklaraci proměnných v extra bloku před tělem,
  ; podobně, jako v Pascalu
  ; zde však také vyžadují výchozí hodnotu
  ; 'N' je alias pro 'Nil'
  foo:N
  bar:N
]:[
  ; přiřazení do proměnné
  foo := fact-fun
  ; right-associative operátor '\' tvoří cons cell
  bar := foo\fact-imp\N
  ; list se dá také vytvořit konstruktem 'list'
  ; bar := list [foo fact-imp]

  ; pro deklaraci jedné proměnné se blok za 'var' psát nemusí
  ; funkce se volají stylem S-exprese
  ; 'lamb' tvoří lambda funkci
  var baz : [mapl bar lamb [fn]:[[fn fact-arg]]]

  ; println zatím jen debugovací, bere jen jeden argument a vypisuje interní
  ; reprezentaci
  [println baz]

  ; pro infix operátory typu '+' existují i odpovídající funkce typu 'f+'
  ; '`' se používá pro prefix mínus, neb absence oddělovače výroků nepovoluje
  ; používat stejný symbol jak pro infix, tak prefix operátor
  [println 0 = [reducel baz f+ `240]]

  ; z důvodů špatně navržené syntaxe se z pole čte přes 'read/r [arr ind]'
  ; a zapisuje se do něj pres 'write/w [arr ind val]'
  ; pro vnořená pole lze napsat více indexů za sebe
  bar := {1 2 3 4 6}
  w [bar 4 5]
  [println [sum-arr bar]]

  ; cyklus iterující na proměnné 'ind' od '6' do '0', oba včetně
  ; také demonstruje blok proměnných v cyklu
  for [ind 0 <- 6]:[
    inter:N
  ]:[
    inter := ind + 0.37
    [println inter]
  ]

  [println [compare 24 42]]

  ; arytmetické infix operátory se dají modifikovat
  [println 3 +:<:9 12]       ; výsledek nepřekročí 9
  [println 3 +:>:9 1]        ; vysledek nepodkročí 9
  [println 3 +:  <:1:9:> 12] ; výsledek neopustí interval <1;9>
  [println 3 +:%:<:1:9:> 12] ; výsledek přetéká v intervalu <1;9>
]


; funkce o dvou argumentech
func [mapl lst fn]:[
  ; podmínka se může skládat z jednoho těla pro případ pravdy, nebo ze dvou,
  ; prvního pro případ pravdy, a druhého pro případ nepravdy
  ; všachna těla vrací hodnotu jejich posledního výroku
  ; neexistující větev vrací 'Nil'
  ; '+>' se chová jako vnořený blok až do konce bloku nadřazeného, takže
  ; následující řádek je ekvivalentní 'if [[nil? lst]]:['
  if [+> nil? lst]:[
    Nil
  ]:[
    ; 'car' a 'cdr' je možné stejně jako v LISPu spojovat do jednoho symbolu
    ; na způsob 'cadr'. Narozníl od LISPu  mohou nabírat libovolné délky, a
    ; také existuje obrácená syntaxe 'rdaac' = 'caadr'
    [cons [fn   [car lst]]
          [mapl [cdr lst] fn]]
  ]
]


func [reducel lst fn init]:[
  ; lambda funkce v bloku proměnných
  aux : lamb [acc lst]:+>
    if [+> nil? lst]:[
      acc
    ]:+> ; '+>' je možné vnořovat hned za sebe
      +> aux  [fn acc +> car lst]  [cdr lst]
]:[
  +> aux init lst
]


; faktoriál funkčním stylem
func [fact-fun num]:[
  var aux : lamb [acc num]:[
    if [num > 0]:[
      [aux  acc * num  num - 1]
    ]:[ acc ]
  ]

  [aux 1 num]
]


; faktoriál imperativním stylem
func [fact-imp num]:[
  acc : 1
]:[
  ; 'foo:*' jako 'foo *=' v C
  ; '--:foo' jako 'foo--' v C
  ; 'foo:--' jako '--foo' v C
  ; přířazení do proměnné vrací hodnotu
  while [num > 0] :+> acc:* --:num
]


func [sum-arr arr]:[
  sum:0
]:[
  ; cyklus iterující na proměnné 'ind' od '0' do delky pole - 1 
  ; tenká šipka  = konečná hodnota inkluzivní
  ; tlustá šipka = konečná hodnota exkluzivní
  for [ind 0 => [len arr]]:[
    sum:+ r [arr ind]
  ]
]


func [compare aa bb]:[
  ; 'cond' na zbůsob 'cond' v LISPu
  cond [aa > bb]:[ 1]
    :  [bb > aa]:[`1]
    :  [   T   ]:[ 0]
]

;;; DALŠÍ NEZMÍNĚNÉ ASPEKTY ;;;
; k 'if' existuje intertní podmínka 'unless'
; k 'while' existuje invertní cyklus 'until'
; také existuje 'do-while' a 'do-until', které se píší stejně, ale podmínku
; sledují až od druhé iterace
; z funkce se dá předčasně navrátit pomocí 'return'
; existuje cyklus bez podmínky 'loop'
; existuje blok 'do', který se jednou spustí a navrátí poslední hodnotu
; existují běžné logické a aritmetické operátory, včetně pythonového '//'
