var [
  fact-arg : 5
]


func [start]:[
  foo:N
  bar:N
]:[
  foo := fact-fun
  bar := foo\fact-imp\N

  var baz : [mapl bar lamb [fn]:[[fn fact-arg]]]
  [println baz]
  [println 0 = [reducel baz f+ `240]]

  bar := {1 2 3 4 6}
  w [bar 4 5]
  [println [sum-arr bar]]

  for [ind 0 <- 6]:[
    inter:N
  ]:[
    inter := ind + 0.37
    [println inter]
  ]

  [println [compare 24 42]]

  [println 3 +:<:9 12]
  [println 3 +:>:9 1]
  [println 3 +:  <:1:9:> 12]
  [println 3 +:%:<:1:9:> 12]
]


func [mapl lst fn]:[
  if [+> nil? lst]:[
    Nil
  ]:[
    [cons [fn   [car lst]]
          [mapl [cdr lst] fn]]
  ]
]


func [reducel lst fn init]:[
  aux : lamb [acc lst]:+>
    if [+> nil? lst]:[
      acc
    ]:+>
      +> aux  [fn acc +> car lst]  [cdr lst]
]:[
  +> aux init lst
]


func [fact-fun num]:[
  var aux : lamb [acc num]:[
    if [num > 0]:[
      [aux  acc * num  num - 1]
    ]:[ acc ]
  ]

  [aux 1 num]
]


func [fact-imp num]:[
  acc : 1
]:[
  while [num > 0] :+> acc:* --:num
]


func [sum-arr arr]:[
  sum:0
]:[
  for [ind 0 => [len arr]]:[
    sum:+ r [arr ind]
  ]
]


func [compare aa bb]:[
  cond [aa > bb]:[ 1]
    :  [bb > aa]:[`1]
    :  [   T   ]:[ 0]
]
