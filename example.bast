func [add2-ind ind xx]:[
  [println "" ~ ind ~ ": " ~ xx]
  xx + 2
]

func [add2 xx]:[
  xx + 2
]


func [gt3 xx]:[
  xx > 3
]


func [main]:[
  foo:{1 2 3}
  bar:1\2\3\N
]:[
  [println [filter [rev [automap foo add2-ind]] gt3]]
  [println [rev [automap bar add2]]]
  [println [filter [rev [map bar add2]] gt3]]
]
